<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>OpenClaw.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>OpenClaw.Core</PackageId>
    <Description>Core abstractions, models, validation, security, and memory primitives for OpenClaw.NET.</Description>
    <PackageTags>openclaw;ai;agent;dotnet;llm</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OpenClaw.Tests" />
    <InternalsVisibleTo Include="OpenClaw.Gateway" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Jinja2.NET" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="NCrontab" />
    <PackageReference Include="TickerQ" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../compat/public-smoke.json" LogicalName="OpenClaw.Core.Compatibility.public-smoke.json" />
  </ItemGroup>
</Project>
