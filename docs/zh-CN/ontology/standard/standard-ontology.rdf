<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE rdf:RDF [
	<!ENTITY rdf 'http://www.w3.org/1999/02/22-rdf-syntax-ns#'>
	<!ENTITY rdfs 'http://www.w3.org/2000/01/rdf-schema#'>
	<!ENTITY xsd 'http://www.w3.org/2001/XMLSchema#'>
	<!ENTITY owl 'http://www.w3.org/2002/07/owl#'>
	<!ENTITY std 'http://openclaw.net/ontology/standard#'>
]>
<rdf:RDF xml:base="http://openclaw.net/ontology/standard#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:std="http://openclaw.net/ontology/standard#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <owl:Ontology rdf:about="&std;">
    <rdfs:comment xml:lang="zh">GB/T 48000.3-2026 标准数字化核心本体</rdfs:comment>
    <rdfs:comment xml:lang="zh">基于 GB/T 48000.3-2026《标准数字化 第3部分：本体建模要求》定义的标准数字化核心本体，包含 18 种核心实体类型（附录 B）、34 种核心对象属性（7.3.2）与 47 种核心数据属性（附录 C）。</rdfs:comment>
    <rdfs:label xml:lang="zh">GB/T 48000.3-2026 标准数字化本体</rdfs:label>
  </owl:Ontology>
  <owl:Class rdf:about="&std;ActionClass">
    <rdfs:comment xml:lang="zh">描述性动作类别（如测试方法、操作步骤）。</rdfs:comment>
    <rdfs:label xml:lang="zh">动作类</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="&std;CCS_code">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">中国标准文献分类（CCS）代码。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;ChineseClassificationofStandard" />
    <rdfs:label xml:lang="zh">CCS分类代码</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;CCS_name">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">中国标准文献分类（CCS）名称。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;ChineseClassificationofStandard" />
    <rdfs:label xml:lang="zh">CCS分类名称</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="&std;CapabilityProperty">
    <rdfs:comment xml:lang="zh">能力型特性。</rdfs:comment>
    <rdfs:label xml:lang="zh">能力型特性</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;Property" />
  </owl:Class>
  <owl:Class rdf:about="&std;ChineseClassificationofStandard">
    <rdfs:comment xml:lang="zh">CCS 中国标准文献分类。</rdfs:comment>
    <rdfs:label xml:lang="zh">中国标准分类</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;DomainCategory" />
  </owl:Class>
  <owl:Class rdf:about="&std;Clause">
    <rdfs:comment xml:lang="zh">信息单元的一种，代表条文性约束。</rdfs:comment>
    <rdfs:label xml:lang="zh">条款</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;InformationUnit" />
  </owl:Class>
  <owl:Class rdf:about="&std;CodeForm">
    <rdfs:comment xml:lang="zh">以程序代码或伪代码表示。</rdfs:comment>
    <rdfs:label xml:lang="zh">代码形式</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;InformationForm" />
  </owl:Class>
  <owl:Class rdf:about="&std;Constraint">
    <rdfs:comment xml:lang="zh">具体的数值约束或逻辑约束条件。</rdfs:comment>
    <rdfs:label xml:lang="zh">约束逻辑</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="&std;ConstraintProperty">
    <rdfs:comment xml:lang="zh">约束型特性。</rdfs:comment>
    <rdfs:label xml:lang="zh">约束型特性</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;Property" />
  </owl:Class>
  <owl:Class rdf:about="&std;ContentElement">
    <rdfs:comment xml:lang="zh">标准的规范性/资料性内容要素。</rdfs:comment>
    <rdfs:label xml:lang="zh">内容要素</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="&std;DescriptiveProperty">
    <rdfs:comment xml:lang="zh">描述型特性。</rdfs:comment>
    <rdfs:label xml:lang="zh">描述型特性</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;Property" />
  </owl:Class>
  <owl:Class rdf:about="&std;Determination">
    <rdfs:comment xml:lang="zh">最小可执行规则（合规判定/路径判定）。</rdfs:comment>
    <rdfs:label xml:lang="zh">判定</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;ActionClass" />
  </owl:Class>
  <owl:Class rdf:about="&std;DocumentNumber">
    <rdfs:comment xml:lang="zh">标准文件编号，用于支持版本追溯（§6.3.2）。</rdfs:comment>
    <rdfs:label xml:lang="zh">文件编号</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="&std;DomainCategory">
    <rdfs:comment xml:lang="zh">根据标准领域对标准的分类（如 ICS、CCS）。</rdfs:comment>
    <rdfs:label xml:lang="zh">领域类别</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="&std;Example">
    <rdfs:comment xml:lang="zh">信息单元的一种，代表示例说明。</rdfs:comment>
    <rdfs:label xml:lang="zh">示例</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;InformationUnit" />
  </owl:Class>
  <owl:Class rdf:about="&std;ExternalResource">
    <rdfs:comment xml:lang="zh">与标准相关的外部文件，如法律法规、专利、标准文献、行业数据库等。</rdfs:comment>
    <rdfs:label xml:lang="zh">外部约束</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="&std;FigureForm">
    <rdfs:comment xml:lang="zh">以图形、图像或图表表示。</rdfs:comment>
    <rdfs:label xml:lang="zh">图表形式</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;InformationForm" />
  </owl:Class>
  <owl:Class rdf:about="&std;FormulaForm">
    <rdfs:comment xml:lang="zh">以数学公式表示。</rdfs:comment>
    <rdfs:label xml:lang="zh">公式形式</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;InformationForm" />
  </owl:Class>
  <owl:DatatypeProperty rdf:about="&std;ICS_code">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">国际标准分类（ICS）代码。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;InternationalClassificationofStandard" />
    <rdfs:label xml:lang="zh">ICS分类代码</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;ICS_name">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">国际标准分类（ICS）名称。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;InternationalClassificationofStandard" />
    <rdfs:label xml:lang="zh">ICS分类名称</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:Class rdf:about="&std;Individual">
    <rdfs:comment xml:lang="zh">代表个人实体。</rdfs:comment>
    <rdfs:label xml:lang="zh">个体</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;Stakeholder" />
  </owl:Class>
  <owl:Class rdf:about="&std;InformationForm">
    <rdfs:comment xml:lang="zh">信息单元的不同表现形式（文本、图表、公式、代码等）。</rdfs:comment>
    <rdfs:label xml:lang="zh">信息单元表示形式</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="&std;InformationUnit">
    <rdfs:comment xml:lang="zh">标准内容的最小信息模块（条款、示例、注、列表等）。</rdfs:comment>
    <rdfs:label xml:lang="zh">信息单元</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="&std;InformativeElement">
    <rdfs:comment xml:lang="zh">标准的资料性要素（规范性引用文件、参考文献、索引等）。</rdfs:comment>
    <rdfs:label xml:lang="zh">资料性要素</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;ContentElement" />
  </owl:Class>
  <owl:Class rdf:about="&std;InternationalClassificationofStandard">
    <rdfs:comment xml:lang="zh">ICS 国际标准分类。</rdfs:comment>
    <rdfs:label xml:lang="zh">国际标准分类</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;DomainCategory" />
  </owl:Class>
  <owl:Class rdf:about="&std;Item">
    <rdfs:comment xml:lang="zh">列表中的编号或未编号项。</rdfs:comment>
    <rdfs:label xml:lang="zh">项</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;Level" />
  </owl:Class>
  <owl:Class rdf:about="&std;LawRegulation">
    <rdfs:comment xml:lang="zh">法律或行政法规。</rdfs:comment>
    <rdfs:label xml:lang="zh">法律法规</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;ExternalResource" />
  </owl:Class>
  <owl:Class rdf:about="&std;Level">
    <rdfs:comment xml:lang="zh">标准结构中的层级概念，用于表示标准内容的组织层次。</rdfs:comment>
    <rdfs:label xml:lang="zh">层次</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="&std;List">
    <rdfs:comment xml:lang="zh">信息单元的一种，代表枚举或列表。</rdfs:comment>
    <rdfs:label xml:lang="zh">列表</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;InformationUnit" />
  </owl:Class>
  <owl:Class rdf:about="&std;NormativeElement">
    <rdfs:comment xml:lang="zh">标准的规范性要素（范围、术语和定义、符号和缩略语、核心技术要素、管理技术要素等）。</rdfs:comment>
    <rdfs:label xml:lang="zh">规范性要素</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;ContentElement" />
    <owl:disjointWith rdf:resource="&std;InformativeElement" />
  </owl:Class>
  <owl:Class rdf:about="&std;Note">
    <rdfs:comment xml:lang="zh">信息单元的一种，代表注释说明。</rdfs:comment>
    <rdfs:label xml:lang="zh">注</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;InformationUnit" />
  </owl:Class>
  <owl:Class rdf:about="&std;Object">
    <rdfs:comment xml:lang="zh">标准涉及的人员、设备、材料、软件等实体。</rdfs:comment>
    <rdfs:label xml:lang="zh">对象</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="&std;Organization">
    <rdfs:comment xml:lang="zh">代表企业、协会、委员会等组织实体。</rdfs:comment>
    <rdfs:label xml:lang="zh">组织</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;Stakeholder" />
    <owl:disjointWith rdf:resource="&std;Individual" />
  </owl:Class>
  <owl:Class rdf:about="&std;Paragraph">
    <rdfs:comment xml:lang="zh">不带编号的文本段落实体。</rdfs:comment>
    <rdfs:label xml:lang="zh">段</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;Level" />
  </owl:Class>
  <owl:Class rdf:about="&std;Patent">
    <rdfs:comment xml:lang="zh">专利文献。</rdfs:comment>
    <rdfs:label xml:lang="zh">专利</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;ExternalResource" />
  </owl:Class>
  <owl:Class rdf:about="&std;Property">
    <rdfs:comment xml:lang="zh">产品/服务/过程的量化或描述属性。</rdfs:comment>
    <rdfs:label xml:lang="zh">特性</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="&std;ReferenceDocument">
    <rdfs:comment xml:lang="zh">标准中引用的其他标准或文献。</rdfs:comment>
    <rdfs:label xml:lang="zh">参考文献</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;ExternalResource" />
  </owl:Class>
  <owl:Class rdf:about="&std;Section">
    <rdfs:comment xml:lang="zh">标准中编号为章的逻辑单元。</rdfs:comment>
    <rdfs:label xml:lang="zh">章</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;Level" />
  </owl:Class>
  <owl:Class rdf:about="&std;Stakeholder">
    <rdfs:comment xml:lang="zh">参与标准活动的组织和个人（B.3）。</rdfs:comment>
    <rdfs:label xml:lang="zh">相关方</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="&std;Standard">
    <rdfs:comment xml:lang="zh">标准文件的核心根节点，用于表示具有唯一标识的标准文件实例，聚合元数据、结构和内容及制定过程。</rdfs:comment>
    <rdfs:label xml:lang="zh">标准实体</rdfs:label>
    <owl:disjointWith rdf:resource="&std;ActionClass" />
    <owl:disjointWith rdf:resource="&std;Constraint" />
    <owl:disjointWith rdf:resource="&std;ContentElement" />
    <owl:disjointWith rdf:resource="&std;DomainCategory" />
    <owl:disjointWith rdf:resource="&std;ExternalResource" />
    <owl:disjointWith rdf:resource="&std;InformationUnit" />
    <owl:disjointWith rdf:resource="&std;Level" />
    <owl:disjointWith rdf:resource="&std;Object" />
    <owl:disjointWith rdf:resource="&std;Property" />
    <owl:disjointWith rdf:resource="&std;Stakeholder" />
    <owl:disjointWith rdf:resource="&std;StandardizationObject" />
    <owl:disjointWith rdf:resource="&std;StandardizationProcess" />
    <owl:disjointWith rdf:resource="&std;StructuralElement" />
    <owl:disjointWith rdf:resource="&std;Term" />
    <owl:hasKey rdf:parseType="Resource">
      <rdf:first rdf:resource="&std;standardNumber" />
      <rdf:rest rdf:resource="&rdf;nil" />
    </owl:hasKey>
  </owl:Class>
  <owl:Class rdf:about="&std;StandardizationObject">
    <rdfs:comment xml:lang="zh">描述标准化的具体对象或主题。</rdfs:comment>
    <rdfs:label xml:lang="zh">标准化对象</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="&std;StandardizationProcess">
    <rdfs:comment xml:lang="zh">标准生命周期中的各个阶段（预备、立项、起草、征求意见、技术审查、批准发布、出版、复审、废止）。</rdfs:comment>
    <rdfs:label xml:lang="zh">制定程序</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="&std;StructuralElement">
    <rdfs:comment xml:lang="zh">标准的章、条、段、项等结构要素。</rdfs:comment>
    <rdfs:label xml:lang="zh">结构要素</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="&std;TableForm">
    <rdfs:comment xml:lang="zh">以表格表示。</rdfs:comment>
    <rdfs:label xml:lang="zh">表格形式</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;InformationForm" />
  </owl:Class>
  <owl:Class rdf:about="&std;Term">
    <rdfs:comment xml:lang="zh">标准中界定的具有特定含义的专业词语。</rdfs:comment>
    <rdfs:label xml:lang="zh">术语</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="&std;TextForm">
    <rdfs:comment xml:lang="zh">以纯文本表示。</rdfs:comment>
    <rdfs:label xml:lang="zh">文本形式</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;InformationForm" />
  </owl:Class>
  <owl:Class rdf:about="&std;TitledClause">
    <rdfs:comment xml:lang="zh">带有标题的条款。</rdfs:comment>
    <rdfs:label xml:lang="zh">有标题条</rdfs:label>
    <rdfs:subClassOf rdf:resource="&std;Clause" />
  </owl:Class>
  <owl:Class rdf:about="&std;Version">
    <rdfs:comment xml:lang="zh">标准的特定发布版本，支持版本追溯和差异对比（§6.3.1）。</rdfs:comment>
    <rdfs:label xml:lang="zh">版本</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="&std;address">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">个人的联系地址。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Individual" />
    <rdfs:label xml:lang="zh">联系地址</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="&std;administeredBy">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdf:type rdf:resource="&owl;FunctionalProperty" />
    <rdfs:comment xml:lang="zh">标准由某单位归口管理。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">归口于</rdfs:label>
    <rdfs:range rdf:resource="&std;Organization" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;adopts">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">当前标准采用（等同/修改）另一标准。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">采用</rdfs:label>
    <rdfs:range rdf:resource="&std;Standard" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="&std;affiliation">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">个人所属的机构或组织名称。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Individual" />
    <rdfs:label xml:lang="zh">所属单位</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="&std;cites">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准规范性引用另一标准。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">引用（标准）</rdfs:label>
    <rdfs:range rdf:resource="&std;Standard" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;citesStandard">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">条款内容中引用了某个标准。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Clause" />
    <rdfs:label xml:lang="zh">引用标准（条款）</rdfs:label>
    <rdfs:range rdf:resource="&std;Standard" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;classifiedUnder">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准按领域分类（如 ICS、CCS）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">属于领域</rdfs:label>
    <rdfs:range rdf:resource="&std;DomainCategory" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="&std;clauseNumber">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">条的层级编号（如“4.1”）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Clause" />
    <rdfs:label xml:lang="zh">条编号</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;clauseTitle">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">有标题条的标题。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;TitledClause" />
    <rdfs:label xml:lang="zh">条标题</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;clauseType">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标识条款类型（枚举：要求型、推荐型、指示型、允许型、陈述型）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Clause" />
    <rdfs:label xml:lang="zh">条款类型</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="&std;constrainsCharacteristic">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">约束条件应用于对象的某个特性。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Constraint" />
    <rdfs:label xml:lang="zh">约束特性</rdfs:label>
    <rdfs:range rdf:resource="&std;Property" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;constrainsObject">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">约束条件应用于某个具体对象。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Constraint" />
    <rdfs:label xml:lang="zh">约束对象</rdfs:label>
    <rdfs:range rdf:resource="&std;Object" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="&std;constraintType">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">约束的形式（枚举：数值区间、枚举值、逻辑表达式）。</rdfs:comment>
    <rdfs:comment xml:lang="zh">规定条款的约束级别（枚举：强制、推荐、描述）。</rdfs:comment>
    <rdfs:comment xml:lang="zh">规定标准的约束级别（枚举：强制性、推荐性）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Clause" />
    <rdfs:domain rdf:resource="&std;Constraint" />
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">约束类型</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;contentDescription">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">信息单元的详细描述文本。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;InformationUnit" />
    <rdfs:label xml:lang="zh">内容描述</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;creditCode">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdf:type rdf:resource="&owl;FunctionalProperty" />
    <rdfs:comment xml:lang="zh">由 18 位数字/字母组成的唯一标识符（正则 ^[A-Z0-9]{18}$）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Organization" />
    <rdfs:label xml:lang="zh">统一信用代码</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="&std;defines">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准或要素界定了某个术语。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">界定</rdfs:label>
    <rdfs:range rdf:resource="&std;Term" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;describesAction">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">信息单元规定的执行动作或操作步骤。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;InformationUnit" />
    <rdfs:label xml:lang="zh">描述动作</rdfs:label>
    <rdfs:range rdf:resource="&std;ActionClass" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="&std;documentName">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准的完整名称，如“电动自行车安全技术规范”。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">文件名称</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="&std;draftedBy">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准由某起草单位或起草人起草。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">起草于</rdfs:label>
    <rdfs:range rdf:resource="&std;Stakeholder" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="&std;effectiveDate">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准开始实施的日期，可能与发布日期不同（格式 YYYY-MM-DD）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">实施日期</rdfs:label>
    <rdfs:range rdf:resource="&xsd;date" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;effectiveTime">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">文件的生效日期（格式 YYYY-MM-DD）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;ExternalResource" />
    <rdfs:label xml:lang="zh">生效时间</rdfs:label>
    <rdfs:range rdf:resource="&xsd;date" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;elementStatus">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标识要素的存在状态（枚举：必备、可选）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;ContentElement" />
    <rdfs:label xml:lang="zh">要素状态</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;endDate">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">某个阶段活动完成的具体时间点（格式 YYYY-MM-DD）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;StandardizationProcess" />
    <rdfs:label xml:lang="zh">结束日期</rdfs:label>
    <rdfs:range rdf:resource="&xsd;date" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;fileType">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">外部文件的分类（枚举：法规、专利、文献、公共数据库）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;ExternalResource" />
    <rdfs:label xml:lang="zh">文件类型</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="&std;hasCharacteristic">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">对象具有某种可量化或描述的特性。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Object" />
    <rdfs:label xml:lang="zh">具有特性</rdfs:label>
    <rdfs:range rdf:resource="&std;Property" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;hasClause">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">要素或结构层次包含了一个具体的条款。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;ContentElement" />
    <rdfs:label xml:lang="zh">包含条款</rdfs:label>
    <rdfs:range rdf:resource="&std;Clause" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;hasDevelopmentStage">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准当前所处的生命周期阶段。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">处于阶段</rdfs:label>
    <rdfs:range rdf:resource="&std;StandardizationProcess" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;hasDocumentNumber">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准通识的文件编号（用于版本管理）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">有文件编号</rdfs:label>
    <rdfs:range rdf:resource="&std;DocumentNumber" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;hasExample">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">条款关联示例。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Clause" />
    <rdfs:label xml:lang="zh">有示例</rdfs:label>
    <rdfs:range rdf:resource="&std;Example" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;hasNormativeElement">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准包含规范性/资料性要素（如术语、范围）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">包含要素</rdfs:label>
    <rdfs:range rdf:resource="&std;ContentElement" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;hasNote">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">条款关联注。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Clause" />
    <rdfs:label xml:lang="zh">有注</rdfs:label>
    <rdfs:range rdf:resource="&std;Note" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;hasPart">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">本标准由多个部分系列标准组成，当前标准是其中一个部分。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">有部分</rdfs:label>
    <rdfs:range rdf:resource="&std;Standard" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;hasRepresentationForm">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">信息单元（条款等）有内容形式（条文、图、表等）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;InformationUnit" />
    <rdfs:label xml:lang="zh">具有表述形式</rdfs:label>
    <rdfs:range rdf:resource="&std;InformationForm" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;hasStructuralElement">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准或其内部结构包含章、条、段等层级结构。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">包含层次</rdfs:label>
    <rdfs:range rdf:resource="&std;Level" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;hasSubClause">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdf:type rdf:resource="&owl;TransitiveProperty" />
    <rdfs:comment xml:lang="zh">表示条包含子条，用于构建层次结构。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Clause" />
    <rdfs:label xml:lang="zh">包含子条</rdfs:label>
    <rdfs:range rdf:resource="&std;Clause" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;hasVersion">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准具有的发布版本。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">有版本</rdfs:label>
    <rdfs:range rdf:resource="&std;Version" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;imposesConstraint">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">信息单元或特性包含具体的约束条件（如阈值）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;InformationUnit" />
    <rdfs:label xml:lang="zh">施加约束</rdfs:label>
    <rdfs:range rdf:resource="&std;Constraint" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;includesStandard">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">制定程序阶段所包含的标准（处于阶段属性的逆向属性）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;StandardizationProcess" />
    <rdfs:label xml:lang="zh">包含标准</rdfs:label>
    <rdfs:range rdf:resource="&std;Standard" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="&std;industrialSector">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">指明标准化对象所服务的特定行业分类或领域（行业分类见 GB/T 4754）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;StandardizationObject" />
    <rdfs:label xml:lang="zh">所属行业</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="&std;involvesObject">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">条款提及了人、设备、材料等对象。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Clause" />
    <rdfs:label xml:lang="zh">涉及对象</rdfs:label>
    <rdfs:range rdf:resource="&std;Object" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;isRelatedToPatent">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">条款的技术内容与某项专利有关。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Clause" />
    <rdfs:label xml:lang="zh">与专利有关</rdfs:label>
    <rdfs:range rdf:resource="&std;Patent" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;issuedBy">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdf:type rdf:resource="&owl;FunctionalProperty" />
    <rdfs:comment xml:lang="zh">标准由某机构正式发布。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">发布于</rdfs:label>
    <rdfs:range rdf:resource="&std;Organization" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="&std;issuedDate">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准的官方发布日期（GB/T 7408，格式 YYYY-MM-DD）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">发布日期</rdfs:label>
    <rdfs:range rdf:resource="&xsd;date" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;languageVersion">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准发布的语言版本（枚举：中文版本、英文版本、多语种）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">语言版本</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;maxValue">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">数值约束的最大允许值（如“100W”）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Constraint" />
    <rdfs:label xml:lang="zh">最大值</rdfs:label>
    <rdfs:range rdf:resource="&xsd;decimal" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;minValue">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">数值约束的最小允许值（如“80W”）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Constraint" />
    <rdfs:label xml:lang="zh">最小值</rdfs:label>
    <rdfs:range rdf:resource="&xsd;decimal" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;objectCategory">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标识对象类别（如“设备”“材料”）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Object" />
    <rdfs:label xml:lang="zh">对象类别</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;objectName">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">对象的名称（如“锂电池”“电机控制器”）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Object" />
    <rdfs:label xml:lang="zh">对象名称</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;orgLocation">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">机构的实际办公或注册地址（格式：省/市）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Organization" />
    <rdfs:label xml:lang="zh">所在地</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;orgName">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标识机构的法定或通用名称。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Organization" />
    <rdfs:label xml:lang="zh">名称</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;personName">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">个人法定姓名。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Individual" />
    <rdfs:label xml:lang="zh">姓名</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;phone">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">个人的联系电话号码（格式：+86-区号-号码）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Individual" />
    <rdfs:label xml:lang="zh">联系电话</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;propertyName">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">特性的名称（如“电压”“功率”）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Property" />
    <rdfs:label xml:lang="zh">特性名称</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;propertyType">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标识特性类型（枚举：描述型、能力型、约束型）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Property" />
    <rdfs:label xml:lang="zh">特性类型</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;propertyValue">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">特性的具体值（如“48V”“500W”）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Property" />
    <rdfs:label xml:lang="zh">特性值</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="&std;proposedBy">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准由某单位提出。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">提出于</rdfs:label>
    <rdfs:range rdf:resource="&std;Organization" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;publishedBy">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准由某出版机构出版。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">出版于</rdfs:label>
    <rdfs:range rdf:resource="&std;Organization" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="&std;purpose">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">说明该标准的制定目标，如“促进技术统一”“保障安全性”等。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">编制目的</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="&std;references">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准资料性参考另一标准（通常在参考文献中列出）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">参考</rdfs:label>
    <rdfs:range rdf:resource="&std;Standard" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;referencesClause">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">信息单元引用本标准内的章、条、段、项。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;InformationUnit" />
    <rdfs:label xml:lang="zh">引用章条</rdfs:label>
    <rdfs:range rdf:resource="&std;Level" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;referencesExternalResource">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标准或条款引用了法规、专利、标准文献等。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">引用外部资源</rdfs:label>
    <rdfs:range rdf:resource="&std;ExternalResource" />
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="&std;replaces">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">新版本标准代替旧版本标准（逆属性为 isReplacedBy）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">代替</rdfs:label>
    <rdfs:range rdf:resource="&std;Standard" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="&std;responsibleParty">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">文件的责任主体（如“国家标准化管理委员会”）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;ExternalResource" />
    <rdfs:label xml:lang="zh">责任主体</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;scopeOfEffect">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">规定要素的适用范围。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;ContentElement" />
    <rdfs:label xml:lang="zh">作用范围</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;sectionNumber">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">章的层级编号（如“4”）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Section" />
    <rdfs:label xml:lang="zh">章编号</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;sectionTitle">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">章的标题（如“质量管理体系”）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Section" />
    <rdfs:label xml:lang="zh">章标题</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="&std;specifiesCharacteristic">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">条款对某个特性的参数/指标做出了规定。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Clause" />
    <rdfs:label xml:lang="zh">规定特性</rdfs:label>
    <rdfs:range rdf:resource="&std;Property" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="&std;stageCode">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdf:type rdf:resource="&owl;FunctionalProperty" />
    <rdfs:comment xml:lang="zh">用于唯一标识和区分标准制定过程中的不同阶段。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;StandardizationProcess" />
    <rdfs:label xml:lang="zh">阶段代码</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;standardNumber">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdf:type rdf:resource="&owl;FunctionalProperty" />
    <rdfs:comment xml:lang="zh">符合 GB/T 1.1 的编号格式，如“GB/T 12345—2023”（格式：标准代号+顺序号+发布年份）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">文件编号</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="&std;standardizes">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">本标准所规范的主题对象。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">规范对象</rdfs:label>
    <rdfs:range rdf:resource="&std;StandardizationObject" />
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="&std;startDate">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">某个阶段活动开始的具体时间点（格式 YYYY-MM-DD）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;StandardizationProcess" />
    <rdfs:label xml:lang="zh">开始日期</rdfs:label>
    <rdfs:range rdf:resource="&xsd;date" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;status">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标识标准的状态（枚举：草案、现行、废止、修订中）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Standard" />
    <rdfs:label xml:lang="zh">标准状态</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;subjectName">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">标识并描述被标准化的事物的主题名称。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;StandardizationObject" />
    <rdfs:label xml:lang="zh">主题名称</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;thresholdRange">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">数值的有效范围（如“80-100W”，格式：最小值-最大值）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Constraint" />
    <rdfs:label xml:lang="zh">阈值范围</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;uniqueldentifier">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">信息单元的唯一编码（如“IU-001”）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;InformationUnit" />
    <rdfs:label xml:lang="zh">唯一标识符</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="&std;unit">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">数值的单位（如“V”“W”）。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;Constraint" />
    <rdfs:label xml:lang="zh">测量单位</rdfs:label>
    <rdfs:range rdf:resource="&xsd;string" />
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="&std;usesTerm">
    <rdf:type rdf:resource="&rdf;Property" />
    <rdfs:comment xml:lang="zh">信息单元提及了某个术语。</rdfs:comment>
    <rdfs:domain rdf:resource="&std;InformationUnit" />
    <rdfs:label xml:lang="zh">提及术语</rdfs:label>
    <rdfs:range rdf:resource="&std;Term" />
  </owl:ObjectProperty>
</rdf:RDF>