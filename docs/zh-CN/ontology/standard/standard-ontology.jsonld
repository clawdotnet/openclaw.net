    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "zh",
        "@value": "GB/T 48000.3-2026 标准数字化本体"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "zh",
        "@value": "基于 GB/T 48000.3-2026《标准数字化 第3部分：本体建模要求》定义的标准数字化核心本体，包含 18 种核心实体类型（附录 B）、34 种核心对象属性（7.3.2）与 47 种核心数据属性（附录 C）。"
      },
      {
        "@language": "zh",
        "@value": "GB/T 48000.3-2026 标准数字化核心本体"
      }
    ]
  },
