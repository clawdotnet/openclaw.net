<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>OpenClaw.StrategosWorkflowHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenClaw.Core\OpenClaw.Core.csproj" />
    <InternalsVisibleTo Include="OpenClaw.StrategosWorkflowHost.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LevelUp.Strategos" Version="2.10.0" />
    <PackageReference Include="LevelUp.Strategos.Generators" Version="2.10.0" PrivateAssets="all" />
    <PackageReference Include="LevelUp.Strategos.Agents" Version="2.10.0" />
    <PackageReference Include="LevelUp.Strategos.Ontology" Version="2.10.0" />
    <PackageReference Include="LevelUp.Strategos.Ontology.MCP" Version="2.10.0" />
    <PackageReference Include="LevelUp.Strategos.Ontology.MCP.Hosting" Version="2.10.0" />
    <!--
      MCP SDK pin: LevelUp.Strategos.Ontology.MCP.Hosting 2.10.0 depends on
      ModelContextProtocol 1.3.0. The 1.x and 2.x SDK lines are not binary compatible,
      so the sidecar pins the matching ModelContextProtocol.AspNetCore 1.3.0 rather than
      the gateway's 2.0.0 — the sidecar is a separate process, so the two never share a
      load context. Revisit when Strategos ships against the 2.x SDK line.
    -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
    <PackageReference Include="WolverineFx" Version="6.12.0" />
    <PackageReference Include="WolverineFx.Marten" Version="6.12.0" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.12.0" />
    <PackageReference Include="Marten" Version="9.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
  </ItemGroup>
</Project>
