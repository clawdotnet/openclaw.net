      MCP SDK pin: LevelUp.Strategos.Ontology.MCP.Hosting 3.0.0 depends on
      ModelContextProtocol 2.2.0, so the sidecar pins the matching
      ModelContextProtocol.AspNetCore package explicitly.
    -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="WolverineFx" Version="6.39.1" />
    <PackageReference Include="WolverineFx.Marten" Version="6.39.1" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.39.1" />
    <PackageReference Include="Marten" Version="9.38.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
  </ItemGroup>
