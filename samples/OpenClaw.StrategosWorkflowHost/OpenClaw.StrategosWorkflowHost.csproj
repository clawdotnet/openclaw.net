<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>OpenClaw.StrategosWorkflowHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenClaw.Core\OpenClaw.Core.csproj" />
    <InternalsVisibleTo Include="OpenClaw.StrategosWorkflowHost.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LevelUp.Strategos" Version="3.0.0" />
    <PackageReference Include="LevelUp.Strategos.Infrastructure" Version="3.0.0" />
    <PackageReference Include="LevelUp.Strategos.Generators" Version="3.0.0" PrivateAssets="all" />
    <PackageReference Include="LevelUp.Strategos.Agents" Version="3.0.0" />
    <PackageReference Include="LevelUp.Strategos.Ontology" Version="3.0.0" />
    <PackageReference Include="LevelUp.Strategos.Ontology.MCP" Version="3.0.0" />
    <PackageReference Include="LevelUp.Strategos.Ontology.MCP.Hosting" Version="3.0.0" />
