  <ItemGroup Label="Routing and local decision tools">
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="NLaya" Version="1.0.0" />
    <PackageVersion Include="NLaya.TorchSharp" Version="1.0.0" />
    <PackageVersion Include="ScottPlot" Version="5.1.59" />
    <PackageVersion Include="TorchSharp-cpu" Version="0.107.0" />
  </ItemGroup>

  <ItemGroup Label="Desktop and web">
    <PackageVersion Include="Avalonia" Version="12.0.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.17" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
